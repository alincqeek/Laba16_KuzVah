<Window x:Class="DZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DZ"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="127*"/>
            <ColumnDefinition Width="93*"/>
            <ColumnDefinition Width="244*"/>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="71*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="42*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="148*"/>
        </Grid.RowDefinitions>
        <Label Content="Регистрация" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="1" FontSize="20" Height="36" Width="124"  />
        <TextBox x:Name="Okoshko1" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,11" Grid.RowSpan="2"/>
        <TextBox x:Name="Okoshko2" Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" PreviewTextInput="Okoshko2_PreviewTextInput" />
        <PasswordBox x:Name="Okoshko3" Grid.Column="2" Grid.Row="7" Grid.ColumnSpan="2"/>
        <Button x:Name="Zaregat" Grid.Column="2" Grid.Row="9" Content="Зарегистрироваться" FontSize="14" Margin="0,2,0,0" Click="Zaregat_Click"/>
        <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="3" FontSize="18" Height="32" Width="49"/>
        <Label Content="Возраст:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="5" FontSize="18" Height="34" Width="78" />
        <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="7" FontSize="18" Height="31" Width="76"/>
    </Grid>
</Window>
